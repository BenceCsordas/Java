<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="451.0" prefWidth="543.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.example.diafilmgui.HelloController">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Fájl">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onOpenClick" text="Megnyitás">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="O" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator>
                  </MenuItem>
                  <MenuItem mnemonicParsing="false" onAction="#onCloseClick" text="Kilépés" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Súgó">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onAboutClick" text="Névjegy" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <children>
                  <ListView fx:id="diafilmekLV" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="400.0" minWidth="400.0" prefHeight="400.0" prefWidth="400.0" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="147.0" spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <ComboBox fx:id="cbox" maxWidth="100.0" minWidth="100.0" onAction="#filter" prefWidth="100.0" />
                  <CheckBox fx:id="ff" maxWidth="100.0" minWidth="100.0" mnemonicParsing="false" onAction="#filter" prefWidth="100.0" selected="true" text="Fekete-fehér" />
                  <CheckBox fx:id="szines" maxWidth="100.0" minWidth="100.0" mnemonicParsing="false" onAction="#filter" prefHeight="17.0" prefWidth="100.0" selected="true" text="Színes" />
                  <Label fx:id="darab" alignment="BOTTOM_CENTER" prefHeight="326.0" prefWidth="142.0" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </HBox>
   </children>
</VBox>
