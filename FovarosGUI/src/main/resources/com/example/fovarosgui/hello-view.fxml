<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="283.0" prefWidth="311.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fovarosgui.HelloController">
   <children>
      <MenuBar prefHeight="19.0" prefWidth="311.0">
        <menus>
          <Menu mnemonicParsing="false" text="Fájl">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onOpenClick" text="Megnyitás">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="O" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator>
                  </MenuItem>
                  <MenuItem mnemonicParsing="false" onAction="#onCloseClick" text="Bezárás">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="Q" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator>
                  </MenuItem>
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Súgó">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onNevjegyClick" text="Névjegy" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefHeight="198.0" prefWidth="197.0" HBox.hgrow="ALWAYS">
               <children>
                  <ListView fx:id="listView" minHeight="300.0" minWidth="300.0" prefHeight="300.0" prefWidth="300.0" VBox.vgrow="ALWAYS" />
               </children></VBox>
            <VBox minWidth="149.0" prefHeight="198.0" prefWidth="128.0">
               <children>
                  <Label text="Főváros" />
                  <TextField fx:id="fovaros" />
                  <Label text="Főváros lakossága" />
                  <TextField fx:id="fovarosLak" />
               </children></VBox>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
